<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
          xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
          xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
          xsi:type="MailApp">
  <Id>d35397f3-e593-4a18-912a-35b5a7698622</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Custom Add-in</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Reply with Attachments" />
  <Description DefaultValue="Allows replying to emails while keeping the original attachments." />
  <IconUrl DefaultValue="https://raw.githubusercontent.com/OfficeDev/office-js-snippets/main/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://raw.githubusercontent.com/OfficeDev/office-js-snippets/main/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://www.contoso.com/help" />
  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3000/commands.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.15">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel" />
                
                <Control xsi:type="Button" id="replyWithAttachmentButton">
                  <Label resid="ReplyLabel" />
                  <Supertip>
                    <Title resid="ReplyLabel" />
                    <Description resid="ReplyDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>replyWithAttachment</FunctionName>
                  </Action>
                </Control>

                <Control xsi:type="Button" id="replyAllWithAttachmentButton">
                  <Label resid="ReplyAllLabel" />
                  <Supertip>
                    <Title resid="ReplyAllLabel" />
                    <Description resid="ReplyAllDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>replyAllWithAttachment</FunctionName>
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://raw.githubusercontent.com/OfficeDev/office-js-snippets/main/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://raw.githubusercontent.com/OfficeDev/office-js-snippets/main/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://raw.githubusercontent.com/OfficeDev/office-js-snippets/main/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Reply with Attachments" />
        <bt:String id="ReplyLabel" DefaultValue="Reply w/ Attachments" />
        <bt:String id="ReplyAllLabel" DefaultValue="Reply All w/ Attachments" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ReplyDesc" DefaultValue="Reply to this email and carry over all attachments." />
        <bt:String id="ReplyAllDesc" DefaultValue="Reply All to this email and carry over all attachments." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
